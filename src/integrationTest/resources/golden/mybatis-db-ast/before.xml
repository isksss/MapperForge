<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="io.github.isksss.mapperforge.integration.MybatisDatabaseIntegrationTest$UserMapper"><resultMap id="userResultMap" type="io.github.isksss.mapperforge.integration.MybatisDatabaseIntegrationTest$UserRow"><id property="id" column="id"/><result property="name" column="name"/><result property="email" column="email"/></resultMap><insert id="insertUser">insert into users (id, name, email, deleted) values (#{id}, #{name}, #{email}, false)</insert><select id="findUsers" resultMap="userResultMap">select id, name, email from users where deleted = false and name = #{name} order by id</select></mapper>
