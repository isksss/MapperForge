<mapper namespace="sample.UserMapper">
    <select id="search" resultType="User">
        SELECT
            id,
            name
        FROM users
        <where>
            <if test="ids != null &amp;&amp; ids.size() > 0">
                id IN
                <foreach collection="ids" item="id" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <choose>
                <when test="name != null">
                    AND name = #{name}
                </when>
                <otherwise>
                    AND deleted = false
                </otherwise>
            </choose>
        </where>
    </select>
</mapper>
